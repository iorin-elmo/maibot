# Discord Developer Portalで発行したBotトークン
DISCORD_TOKEN=your-discord-bot-token

# ローカル保存先
DATABASE_PATH=./data/maibot.sqlite

# ブラウザがアクセスする同期用の公開URL
# ローカル利用時は http://127.0.0.1:31337 のままで構いません。
# クラウドへ配置する場合は https://sync.example.com のようなHTTPS URLを設定します。
IMPORT_BASE_URL=http://127.0.0.1:31337

# Botが同期リクエストを待ち受けるアドレスとポート
# リバースプロキシ／トンネルの背後で公開する場合は 0.0.0.0 と任意の内部ポートを設定します。
SYNC_LISTEN_HOST=127.0.0.1
SYNC_LISTEN_PORT=31337

# 譜面定数データの取得先
DXDATA_URL=https://miruku.dxrating.net/api/v1/dxdata
